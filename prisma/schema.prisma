generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// USERS
model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  fullName     String

  // Maritime details
  rank          String?
  vessel        String?
  contractStart DateTime?
  contractEnd   DateTime?
  homeCountry   String?

  // Contact details
  contactNumber String?

  // Emergency contact details
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactNumber       String?

  // Profile avatar
  // INITIALS = show user's initials
  // AVATAR   = show one of the predefined avatars
  avatarMode String  @default("INITIALS")
  avatarId   String?

  // Relationships
  moodLogs         MoodLog[]
  habits           Habit[]
  dailyPlans       DailyPlan[]
  plannerTemplates DayTemplate[]
  workHours        DailyWorkHours[]
  workSessions     WorkSession[]
  emergencies      EmergencyAlert[]
  fitnessStats     DailyFitnessStat[]
  workoutLogs      WorkoutLog[]
  vrEquipment      VREquipment?
  challenges       ChallengeProgress[]
  refreshTokens    RefreshToken[]
  passwordReset    PasswordReset?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// MOOD AND WELLNESS
model MoodLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // QUICK = dashboard mood-only check
  // FULL  = complete 3-step wellbeing check-in
  checkinType String @default("FULL")

  // STEP 1 - Wellbeing
  // All use 1-5
  moodScore   Int?
  energyLevel Int?
  stressLevel Int?

  // STEP 2 - Sleep & Workload
  hoursOfSleep    Float?
  currentWorkload String?

  // Optional text from Step 2
  additionalThoughts String?

  // STEP 3 - Emotions & Notes
  // Multiple feelings can be selected
  feelings String[] @default([])

  journalEntry String?

  loggedAt DateTime @default(now())

  @@index([userId, loggedAt])
}

// 3. PERFECT DAY & HABITS
model Habit {
  id     String @id @default(uuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title      String // e.g., "Daily Sea Safety Check"
  category   String // e.g., "safety", "wellness", "professional"
  targetDays Int    @default(21) // Days to build the habit

  completions HabitCompletion[]

  createdAt DateTime @default(now())
}

model HabitCompletion {
  id      String @id @default(uuid())
  habitId String

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  completedDate DateTime // The day it was checked off

  @@unique([habitId, completedDate])
}

// ======================================================
// DAY PLANNER
// ======================================================

model DailyPlan {
  id     String @id @default(uuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stored as UTC midnight for the selected day
  date DateTime

  mainFocus String?

  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// ======================================================
// DAILY ACTIVITY
// ======================================================

model Activity {
  id          String @id @default(uuid())
  dailyPlanId String

  dailyPlan DailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)

  title    String
  category String

  startTime       DateTime
  durationMinutes Int

  note String?

  isCompleted Boolean @default(false)

  // MANUAL or TEMPLATE
  source String @default("MANUAL")

  // USER or SYSTEM when source = TEMPLATE
  sourceTemplateId   String?
  sourceTemplateType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dailyPlanId, startTime])
}

// ======================================================
// USER-CREATED DAY TEMPLATES
// ======================================================

model DayTemplate {
  id     String @id @default(uuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  category String?

  lastUsedAt DateTime?

  activities DayTemplateActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model DayTemplateActivity {
  id         String @id @default(uuid())
  templateId String

  template DayTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  title    String
  category String

  // Minutes from midnight: 0 - 1439
  startMinute Int

  durationMinutes Int

  note String?

  order Int @default(0)

  @@index([templateId, order])
}

// ======================================================
// DAILY WORK / REST GRID
// ======================================================

model DailyWorkHours {
  id     String @id @default(uuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stored as UTC midnight for the selected date
  date DateTime

  // Exactly 48 half-hour slots:
  // WORK / REST / MEAL / UNRECORDED
  statusBlocks String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// ======================================================
// WORK SESSION
// ======================================================

model WorkSession {
  id     String @id @default(uuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  shipLocation String

  startedAt DateTime
  endedAt   DateTime?

  // LIVE or MANUAL
  source String @default("LIVE")

  // ACTIVE or COMPLETED
  status String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([userId, status])
}

// 5. EMERGENCY HUB (From "Emergency Response Hub" UI)

model EmergencyAlert {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type   String // "Medical", "Mental Health", "Maritime", "Security"
  status String @default("ACTIVE") // "ACTIVE", "RESOLVED"

  triggeredAt DateTime  @default(now())
  resolvedAt  DateTime?
}

// 6. FITNESS & VR GYM

model DailyFitnessStat {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  date DateTime @default(now()) // The day these stats represent

  // Daily Rings / Goals (From "Daily Activity" UI)
  activeMinutes  Int @default(0)
  steps          Int @default(0)
  caloriesBurned Int @default(0)

  // Health Metrics
  heartRateBpm Int?
  sleepHours   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date]) // Ensures only one stat record per user, per day
}

model WorkoutLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  name      String // e.g., "VR Ocean Gym", "Deck Strength Training"
  category  String // "VR", "Cardio", "Yoga", "Strength"
  intensity String // "low", "medium", "high"

  durationMinutes Int
  caloriesBurned  Int

  completedAt DateTime @default(now())
}

model VREquipment {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Equipment Diagnostics
  headsetBattery     Int    @default(100) // Percentage
  controllersBattery Int    @default(100) // Percentage
  trackingQuality    String @default("Excellent")
  playAreaSize       String @default("3m x 2m")

  lastCalibratedAt DateTime @default(now())
}

model ChallengeProgress {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  challengeName String // e.g., "Nautical November", "Sea Legs Challenge"
  currentValue  Int // e.g., 15
  targetValue   Int // e.g., 20
  unit          String // e.g., "workouts", "sessions"

  deadline    DateTime?
  isCompleted Boolean   @default(false)

  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id     String @id @default(uuid())
  token  String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  expiresAt DateTime
}

model PasswordReset {
  id String @id @default(uuid())

  // Only one active forgot-password flow per user
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // OTP is NEVER stored as plain text
  otpHash String

  // OTP validity
  otpExpiresAt DateTime

  // Number of wrong OTP attempts
  otpAttempts Int @default(0)

  // Used for "Resend Code in 00:xx"
  resendAvailableAt DateTime

  // Filled once OTP has been successfully verified
  verifiedAt DateTime?

  // Temporary token used by the final Create New Password screen
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
