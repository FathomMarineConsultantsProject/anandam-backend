generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// USERS
model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  fullName     String

  // Maritime details
  rank          String?
  vessel        String?
  contractStart DateTime?
  contractEnd   DateTime?
  homeCountry   String?

  // Contact details
  contactNumber String?

  // Emergency contact details
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactNumber       String?

  // Profile avatar
  // INITIALS = show user's initials
  // AVATAR   = show one of the predefined avatars
  avatarMode String  @default("INITIALS")
  avatarId   String?

  // Relationships
  moodLogs                 MoodLog[]
  habits                   Habit[]
  dailyPlans               DailyPlan[]
  plannerTemplates         DayTemplate[]
  googleCalendarConnection GoogleCalendarConnection?
  workHours                DailyWorkHours[]
  workSessions             WorkSession[]
  emergencies              EmergencyAlert[]
  fitnessStats             DailyFitnessStat[]
  workoutLogs              WorkoutLog[]
  vrEquipment              VREquipment?
  challenges               ChallengeProgress[]
  refreshTokens            RefreshToken[]
  passwordReset            PasswordReset?

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  FitnessWorkoutSession FitnessWorkoutSession[]
}

// MOOD AND WELLNESS
model MoodLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // QUICK = dashboard mood-only check
  // FULL  = complete 3-step wellbeing check-in
  checkinType String @default("FULL")

  // STEP 1 - Wellbeing
  // All use 1-5
  moodScore   Int?
  energyLevel Int?
  stressLevel Int?

  // STEP 2 - Sleep & Workload
  hoursOfSleep    Float?
  currentWorkload String?

  // Optional text from Step 2
  additionalThoughts String?

  // STEP 3 - Emotions & Notes
  // Multiple feelings can be selected
  feelings String[] @default([])

  journalEntry String?

  loggedAt DateTime @default(now())

  @@index([userId, loggedAt])
}

// 3. PERFECT DAY & HABITS
model Habit {
  id     String @id @default(uuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title      String // e.g., "Daily Sea Safety Check"
  category   String // e.g., "safety", "wellness", "professional"
  targetDays Int    @default(21) // Days to build the habit

  completions HabitCompletion[]

  createdAt DateTime @default(now())
}

model HabitCompletion {
  id      String @id @default(uuid())
  habitId String

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  completedDate DateTime // The day it was checked off

  @@unique([habitId, completedDate])
}

// ======================================================
// DAY PLANNER
// ======================================================

model DailyPlan {
  id     String @id @default(uuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stored as UTC midnight for the selected day
  date DateTime

  mainFocus String?

  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// ======================================================
// DAILY ACTIVITY
// ======================================================

model Activity {
  id          String @id @default(uuid())
  dailyPlanId String

  dailyPlan DailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)

  title    String
  category String

  startTime       DateTime
  durationMinutes Int

  note String?

  isCompleted Boolean @default(false)

  // MANUAL or TEMPLATE
  source String @default("MANUAL")

  // USER or SYSTEM when source = TEMPLATE
  sourceTemplateId   String?
  sourceTemplateType String?

  // ====================================================
  // ACTIVITY TIMEZONE
  //
  // Example:
  // Asia/Kolkata
  // Europe/London
  //
  // Important for Google Calendar because seafarers
  // may operate in different timezones.
  // ====================================================

  timeZone String?

  // ====================================================
  // GOOGLE CALENDAR SYNC
  // ====================================================

  googleEventId    String?
  googleCalendarId String?

  // NOT_SYNCED
  // NOT_CONNECTED
  // SYNCED
  // FAILED
  googleSyncStatus String @default("NOT_SYNCED")

  googleSyncError String?
  googleSyncedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dailyPlanId, startTime])
  @@index([googleEventId])
}

// ======================================================
// GOOGLE CALENDAR CONNECTION
// ======================================================

model GoogleCalendarConnection {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Actual Google account connected through OAuth
  googleEmail String?

  // Normally "primary"
  calendarId String @default("primary")

  // Default timezone for this connection
  // Example: Asia/Kolkata
  timeZone String @default("UTC")

  // NEVER store Google's refresh token as plain text.
  // We encrypt it using GOOGLE_TOKEN_ENCRYPTION_KEY.
  refreshTokenEncrypted String

  scopes String[] @default([])

  isActive Boolean @default(true)

  // Google Calendar reminders
  emailReminderMinutes Int @default(30)
  popupReminderMinutes Int @default(10)

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ======================================================
// USER-CREATED DAY TEMPLATES
// ======================================================

model DayTemplate {
  id     String @id @default(uuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  category String?

  lastUsedAt DateTime?

  activities DayTemplateActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model DayTemplateActivity {
  id         String @id @default(uuid())
  templateId String

  template DayTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  title    String
  category String

  // Minutes from midnight: 0 - 1439
  startMinute Int

  durationMinutes Int

  note String?

  order Int @default(0)

  @@index([templateId, order])
}

// ======================================================
// DAILY WORK / REST GRID
// ======================================================

model DailyWorkHours {
  id     String @id @default(uuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stored as UTC midnight for the selected date
  date DateTime

  // Exactly 48 half-hour slots:
  // WORK / REST / MEAL / UNRECORDED
  statusBlocks String[] @default([])

  // One comment for the whole day
  commentOfDay String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// ======================================================
// WORK SESSION
// ======================================================

model WorkSession {
  id     String @id @default(uuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  shipLocation String

  startedAt DateTime
  endedAt   DateTime?

  // LIVE or MANUAL
  source String @default("LIVE")

  // ACTIVE or COMPLETED
  status String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([userId, status])
}

// 5. EMERGENCY HUB (From "Emergency Response Hub" UI)

model EmergencyAlert {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type   String // "Medical", "Mental Health", "Maritime", "Security"
  status String @default("ACTIVE") // "ACTIVE", "RESOLVED"

  triggeredAt DateTime  @default(now())
  resolvedAt  DateTime?
}

// 6. FITNESS & VR GYM

model DailyFitnessStat {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  date DateTime @default(now()) // The day these stats represent

  // Daily Rings / Goals (From "Daily Activity" UI)
  activeMinutes  Int @default(0)
  steps          Int @default(0)
  caloriesBurned Int @default(0)

  // Health Metrics
  heartRateBpm Int?
  sleepHours   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date]) // Ensures only one stat record per user, per day
}

model WorkoutLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  name      String // e.g., "VR Ocean Gym", "Deck Strength Training"
  category  String // "VR", "Cardio", "Yoga", "Strength"
  intensity String // "low", "medium", "high"

  durationMinutes Int
  caloriesBurned  Int

  completedAt DateTime @default(now())
}

model VREquipment {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Equipment Diagnostics
  headsetBattery     Int    @default(100) // Percentage
  controllersBattery Int    @default(100) // Percentage
  trackingQuality    String @default("Excellent")
  playAreaSize       String @default("3m x 2m")

  lastCalibratedAt DateTime @default(now())
}

model ChallengeProgress {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  challengeName String // e.g., "Nautical November", "Sea Legs Challenge"
  currentValue  Int // e.g., 15
  targetValue   Int // e.g., 20
  unit          String // e.g., "workouts", "sessions"

  deadline    DateTime?
  isCompleted Boolean   @default(false)

  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id     String @id @default(uuid())
  token  String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  expiresAt DateTime
}

model PasswordReset {
  id String @id @default(uuid())

  // Only one active forgot-password flow per user
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // OTP is NEVER stored as plain text
  otpHash String

  // OTP validity
  otpExpiresAt DateTime

  // Number of wrong OTP attempts
  otpAttempts Int @default(0)

  // Used for "Resend Code in 00:xx"
  resendAvailableAt DateTime

  // Filled once OTP has been successfully verified
  verifiedAt DateTime?

  // Temporary token used by the final Create New Password screen
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Add this relation inside your existing User model:
// fitnessWorkoutSessions FitnessWorkoutSession[]

model FitnessWorkout {
  id   String @id @default(uuid())
  slug String @unique

  // GUIDED or VR
  type String

  title           String
  category        String
  difficulty      String
  durationMinutes Int

  shortDescription String
  about            String

  thumbnailUrl   String?
  youtubeVideoId String?

  benefits          String[] @default([])
  beforeYouBegin    String[] @default([])
  requiredEquipment String[] @default([])

  vrLaunchUrl String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  sessions FitnessWorkoutSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive, sortOrder])
  @@index([category])
  @@index([difficulty])
}

model FitnessWorkoutSession {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workoutId String
  workout   FitnessWorkout @relation(fields: [workoutId], references: [id], onDelete: Restrict)

  // IN_PROGRESS / COMPLETED / ABANDONED
  status String @default("IN_PROGRESS")

  progressPercent Float @default(0)
  positionSeconds Int   @default(0)

  confirmedEquipment String[] @default([])

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, updatedAt])
  @@index([userId, completedAt])
  @@index([workoutId])
}

model FitnessChallenge {
  id String @id @default(uuid())

  title       String
  description String

  // ALL_COMPLETIONS / GUIDED_COMPLETIONS / VR_COMPLETIONS
  metric String

  targetValue Int
  unit        String @default("workouts")

  // CALENDAR_MONTH for the current Figma flow
  period String @default("CALENDAR_MONTH")

  startDate DateTime?
  endDate   DateTime?

  // Frontend can map GOLD / GREEN / PURPLE to Figma colors
  themeKey String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}
