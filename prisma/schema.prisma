generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// USERS
model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  fullName         String
  rank             String?
  vessel           String?
  contractStart    DateTime?
  contractEnd      DateTime?
  contactNumber    String?
  emergencyContact String?
  homeCountry      String?

  // Relationships
  moodLogs     MoodLog[]
  habits       Habit[]
  dailyPlans   DailyPlan[]
  workHours    DailyWorkHours[]
  emergencies  EmergencyAlert[]
  fitnessStats DailyFitnessStat[]
  workoutLogs  WorkoutLog[]
  vrEquipment  VREquipment?
  challenges   ChallengeProgress[]
  refreshTokens  RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



//MOOD and Wellness
model MoodLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Storing as integers (0-10 )
  moodScore   Int? // "Mood Score"
  energyLevel Int? // "Exhausted -> Energized"
  stressLevel Int? // "Very Calm -> Very Stressed"

  hoursOfSleep       Float?   // Float allows for 7.5 hours, etc.
  currentWorkload    String?  // e.g., "Light", "Moderate", "Heavy"
  feeling            String?  // e.g., "Anxious", "Calm", "Homesick"
  additionalThoughts String?  
  journalEntry       String?

  loggedAt DateTime @default(now())
}

// 3. PERFECT DAY & HABITS
model Habit {
  id         String   @id @default(uuid())
  userId     String
 
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title      String   // e.g., "Daily Sea Safety Check"
  category   String   // e.g., "safety", "wellness", "professional"
  targetDays Int      @default(21) // Days to build the habit

  completions HabitCompletion[]

  createdAt  DateTime @default(now())
}

model HabitCompletion {
  id            String   @id @default(uuid())
  habitId       String
  
  habit         Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  completedDate DateTime // The day it was checked off
  
  @@unique([habitId, completedDate])
}

model DailyPlan {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  date      DateTime // The day being planned
  mainFocus String? // e.g., "Maintain calm seas mindset"

  activities Activity[]
}

model Activity {
  id          String    @id @default(uuid())
  dailyPlanId String
  dailyPlan   DailyPlan @relation(fields: [dailyPlanId], references: [id])

  title           String // e.g., "Sunrise Meditation"
  category        String // "wellness", "work", "nutrition"
  startTime       DateTime
  durationMinutes Int
  isCompleted     Boolean  @default(false)
}



// --- 4. WORK & REST COMPLIANCE (Interactive Grid) ---
model DailyWorkHours {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date       DateTime // The specific day (e.g., March 14, 2026)

  // This is the magic! An array of exactly 48 booleans.
  // Index 0 = 00:00, Index 1 = 00:30, etc.
  // true = Work (Blue Box), false = Rest (White Box)
  workBlocks Boolean[] 

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // A user can only have one grid saved per day!
  @@unique([userId, date]) 
}
// 5. EMERGENCY HUB (From "Emergency Response Hub" UI)

model EmergencyAlert {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type   String // "Medical", "Mental Health", "Maritime", "Security"
  status String @default("ACTIVE") // "ACTIVE", "RESOLVED"

  triggeredAt DateTime  @default(now())
  resolvedAt  DateTime?
}

// 6. FITNESS & VR GYM

model DailyFitnessStat {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  date DateTime @default(now()) // The day these stats represent

  // Daily Rings / Goals (From "Daily Activity" UI)
  activeMinutes  Int @default(0)
  steps          Int @default(0)
  caloriesBurned Int @default(0)

  // Health Metrics
  heartRateBpm Int?
  sleepHours   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date]) // Ensures only one stat record per user, per day
}

model WorkoutLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  name      String // e.g., "VR Ocean Gym", "Deck Strength Training"
  category  String // "VR", "Cardio", "Yoga", "Strength"
  intensity String // "low", "medium", "high"

  durationMinutes Int
  caloriesBurned  Int

  completedAt DateTime @default(now())
}

model VREquipment {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Equipment Diagnostics
  headsetBattery     Int    @default(100) // Percentage
  controllersBattery Int    @default(100) // Percentage
  trackingQuality    String @default("Excellent")
  playAreaSize       String @default("3m x 2m")

  lastCalibratedAt DateTime @default(now())
}

model ChallengeProgress {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  challengeName String // e.g., "Nautical November", "Sea Legs Challenge"
  currentValue  Int // e.g., 15
  targetValue   Int // e.g., 20
  unit          String // e.g., "workouts", "sessions"

  deadline    DateTime?
  isCompleted Boolean   @default(false)

  updatedAt DateTime @updatedAt
}


model RefreshToken {
  id    String @id @default(uuid())
  token String @unique
  userId String
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  expiresAt DateTime
}