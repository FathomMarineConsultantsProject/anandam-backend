{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    
  
    "strict": false, 
    
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "include": ["src/**/*"]
}